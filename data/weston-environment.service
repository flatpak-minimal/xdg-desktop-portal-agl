[Unit]
Description=Set AGL session environment
After=dbus.socket
Before=xdg-desktop-portal.service
Before=xdg-desktop-portal-agl.service

[Service]
Type=oneshot
RemainAfterExit=yes
# set AGL_WAYLAND_SOCKETS in a drop-in to wait for other sockets
ExecStart=/usr/libexec/agl-session-environment

[Install]
WantedBy=default.target
